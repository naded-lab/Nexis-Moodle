{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexis-moodle",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "triggers": {"crons": ["0 * * * *"]},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexis-moodle-db"
    }
  ]
}
